{
  "styles": [
    {
      "id": "rainbow_strobe",
      "label": "rainbow_strobe",
      "description": "Rainbow base with add-blended strobe overlay — common preset example.",
      "vars": {},
      "layers": [
        { "styleName": "rainbow", "args": ["300", "800"] },
        {
          "styleName": "strobe",
          "args": ["black", "white", "15", "1", "300", "800"],
          "blend": "add",
          "opacity": 16000
        }
      ]
    },
    {
      "id": "fire_blast",
      "label": "fire_blast",
      "description": "Simple fire base with blast overlay — minimal blade_styles.ini example.",
      "vars": {},
      "layers": [
        { "styleName": "fire", "args": ["red", "yellow"] },
        { "styleName": "blast", "args": ["white"] }
      ]
    },
    {
      "id": "with_vars",
      "label": "with_vars",
      "description": "Section variables (`base`, `clash`, …) referenced in layer args via `{{name}}`.",
      "vars": {
        "base": "cyan",
        "ext": "300",
        "ret": "800"
      },
      "layers": [
        { "styleName": "solid", "args": ["{{base}}", "{{ext}}", "{{ret}}"] },
        { "styleName": "clash", "args": ["white"] },
        { "styleName": "blast", "args": ["white"] },
        { "styleName": "responsive_lockup", "args": ["white"] }
      ]
    },
    {
      "id": "smoke_blade",
      "label": "smoke_blade",
      "description": "Blue solid base + smoke_flow (multiply + screen; ext/ret match base) + composable clash/blast/lockup overlays (Fett263 SmokeBlade-style SD recipe).",
      "vars": {
        "base": "blue",
        "ext": "300",
        "ret": "800",
        "lockup": "white",
        "drag": "white",
        "melt": "orange",
        "lb": "white"
      },
      "layers": [
        { "styleName": "solid", "args": ["{{base}}", "{{ext}}", "{{ret}}"] },
        { "styleName": "smoke_flow", "args": ["black", "white", "{{ext}}", "{{ret}}"], "blend": "multiply", "opacity": 24000 },
        { "styleName": "smoke_flow", "args": ["black", "{{base}}", "{{ext}}", "{{ret}}"], "blend": "screen", "opacity": 4000 },
        {
          "styleName": "stripes",
          "args": ["3000", "-600", "0,0,24", "black"],
          "blend": "multiply",
          "opacity": 26000
        },
        { "styleName": "swing", "args": ["white", "200"], "blend": "add", "opacity": 6000 },
        { "styleName": "real_clash", "args": ["white", "16000"] },
        { "styleName": "blast", "args": ["white"] },
        { "styleName": "responsive_lockup", "args": ["{{lockup}}"] },
        { "styleName": "drag", "args": ["{{drag}}"] },
        { "styleName": "melt", "args": ["{{melt}}"] },
        { "styleName": "lb", "args": ["{{lb}}"] }
      ]
    },
    {
      "id": "sine_waves_cyan",
      "label": "sine_waves_cyan",
      "description": "Cyan solid base + four sine_waves multiply masks (bidirectional scroll) + real_clash, blast_wave_random, responsive_lockup, lb — first SD preset example.",
      "vars": {
        "base": "cyan",
        "ext": "300",
        "ret": "800",
        "clash": "white",
        "lockup": "white",
        "lb": "white"
      },
      "layers": [
        { "styleName": "solid", "args": ["{{base}}", "{{ext}}", "{{ret}}"] },
        {
          "styleName": "sine_waves",
          "args": [
            "2400",
            "0",
            "4096",
            "65535",
            "-2000",
            "1800",
            "512",
            "0",
            "49152",
            "-2800",
            "3200",
            "0",
            "8192",
            "65535",
            "1500",
            "2200",
            "256",
            "12288",
            "65535",
            "2200"
          ],
          "blend": "multiply",
          "opacity": 22000
        },
        { "styleName": "real_clash", "args": ["{{clash}}", "16000"] },
        { "styleName": "blast_wave_random", "args": ["{{clash}}"] },
        { "styleName": "responsive_lockup", "args": ["{{lockup}}"] },
        { "styleName": "lb", "args": ["{{lb}}"] }
      ]
    },
