        {
          "styleName": "audio",
          "args": ["{{base}}", "{{tip}}", "{{clash}}", "{{ext}}", "{{ret}}"],
          "blend": "screen",
          "opacity": 8000
        },
        { "styleName": "pulse", "args": ["{{tip}}", "{{pulse_ms}}"], "blend": "multiply", "opacity": 12000 },
        { "styleName": "sparkle", "args": ["white"], "blend": "add", "opacity": 3000 },
        { "styleName": "responsive_lockup", "args": ["{{lockup}}"] },
        { "styleName": "drag", "args": ["{{drag}}"] },
        { "styleName": "melt", "args": ["{{melt}}"] },
