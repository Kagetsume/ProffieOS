{
  "styles": [
    {
      "id": "rainbow_strobe",
      "label": "rainbow_strobe",
      "description": "Rainbow base with add-blended strobe overlay — common preset example.",
      "vars": {},
      "layers": [
        { "styleName": "rainbow", "args": ["300", "800"] },
        {
          "styleName": "strobe",
          "args": ["black", "white", "15", "1", "300", "800"],
          "blend": "add",
          "opacity": 16000
        }
      ]
    },
    {
      "id": "fire_blast",
      "label": "fire_blast",
      "description": "Simple fire base with blast overlay — minimal blade_styles.ini example.",
      "vars": {},
      "layers": [
        { "styleName": "fire", "args": ["red", "yellow"] },
        { "styleName": "blast", "args": ["white"] }
      ]
    },
    {
      "id": "with_vars",
      "label": "with_vars",
      "description": "Section variables (`base`, `clash`, …) referenced in layer args via `{{name}}`.",
      "vars": {
        "base": "cyan",
        "ext": "300",
        "ret": "800"
      },
      "layers": [
        { "styleName": "solid", "args": ["{{base}}", "{{ext}}", "{{ret}}"] },
        { "styleName": "clash", "args": ["white"] },
        { "styleName": "blast", "args": ["white"] },
        { "styleName": "responsive_lockup", "args": ["white"] }
      ]
    },
    {
      "id": "smoke_blade",
      "label": "smoke_blade",
      "description": "Blue solid base through rolling smoke masks + composable clash/blast/lockup overlays (Fett263 SmokeBlade-style SD recipe).",
      "vars": {
        "base": "blue",
        "ext": "300",
        "ret": "800",
        "lockup": "white",
        "drag": "white",
        "melt": "orange",
        "lb": "white"
      },
      "layers": [
        { "styleName": "solid", "args": ["{{base}}", "{{ext}}", "{{ret}}"] },
        { "styleName": "smoke_flow", "args": ["black", "white", "{{ext}}", "{{ret}}"], "blend": "multiply", "opacity": 24000 },
        { "styleName": "smoke_flow", "args": ["black", "{{base}}", "{{ext}}", "{{ret}}"], "blend": "screen", "opacity": 4000 },
        { "styleName": "swing", "args": ["white", "200"], "blend": "add", "opacity": 6000 },
        { "styleName": "blast", "args": ["white"] },
        { "styleName": "real_clash", "args": ["white", "16000"] },
        { "styleName": "responsive_lockup", "args": ["{{lockup}}"] },
        { "styleName": "drag", "args": ["{{drag}}"] },
        { "styleName": "melt", "args": ["{{melt}}"] },
        { "styleName": "lb", "args": ["{{lb}}"] }
      ]
    },
    {
      "id": "smoke_laser",
      "label": "smoke_laser",
      "description": "Solid base through rolling smoke masks + composable clash/blast/lockup overlays (variant of smoke_blade; default base green).",
      "vars": {
        "base": "green",
        "ext": "300",
        "ret": "800",
        "lockup": "white",
        "drag": "white",
        "melt": "orange",
        "lb": "white"
      },
      "layers": [
        { "styleName": "solid", "args": ["{{base}}", "{{ext}}", "{{ret}}"] },
        { "styleName": "smoke_flow", "args": ["black", "white", "{{ext}}", "{{ret}}"], "blend": "multiply", "opacity": 24000 },
        { "styleName": "smoke_flow", "args": ["black", "{{base}}", "{{ext}}", "{{ret}}"], "blend": "screen", "opacity": 4000 },
        { "styleName": "clash", "args": ["white"] },
        { "styleName": "blast", "args": ["white"] },
        { "styleName": "responsive_lockup", "args": ["{{lockup}}"] },
        { "styleName": "drag", "args": ["{{drag}}"] },
        { "styleName": "melt", "args": ["{{melt}}"] },
        { "styleName": "lb", "args": ["{{lb}}"] }
      ]
    },
    {
      "id": "greyscale_mercenary",
      "label": "greyscale_mercenary",
      "description": "Fett263 Greyscale OS7 Mercenary — smoke masks, stripes, swing, and OS7 combat overlays.",
      "vars": {
        "base": "silver",
        "clash": "white",
        "ext": "300",
        "ret": "800",
        "lockup": "white",
        "drag": "white",
        "melt": "orange",
        "lb": "white"
      },
      "layers": [
        { "styleName": "solid_bend", "args": ["{{base}}", "{{ext}}", "{{ret}}"] },
        { "styleName": "fire_mask", "args": ["{{base}}", "{{base}}"], "blend": "multiply", "opacity": 10000 },
        { "styleName": "fire_mask", "args": ["white", "white"], "blend": "multiply", "opacity": 12000 },
        {
          "styleName": "stripes",
          "args": ["2500", "-3000", "{{base}}", "black"],
          "blend": "multiply",
          "opacity": 14000
        },
        { "styleName": "swing", "args": ["white", "375"], "blend": "add", "opacity": 7000 },
        {
          "styleName": "audio",
          "args": ["{{base}}", "white", "{{ext}}", "{{ret}}"],
          "blend": "add",
          "opacity": 5000
        },
        { "styleName": "real_clash", "args": ["{{clash}}", "16000"] },
        { "styleName": "blast_wave_random", "args": ["{{clash}}"] },
        { "styleName": "responsive_lockup", "args": ["{{lockup}}"] },
        { "styleName": "drag", "args": ["{{drag}}"] },
        { "styleName": "melt", "args": ["{{melt}}"] },
        { "styleName": "lb", "args": ["{{lb}}"] }
      ]
    },
