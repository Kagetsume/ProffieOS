{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LayerBlade",
  "version": "0.1.0",
  "identifier": "com.proffieos.layerblade",
  "build": {
    "frontendDist": "../../website/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../website",
    "beforeBuildCommand": "npm run build --prefix ../website"
  },
  "app": {
    "windows": [
      {
        "title": "LayerBlade",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
